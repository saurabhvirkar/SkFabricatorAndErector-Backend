{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://skfabricator.onrender.com"
  ],
  "DatabaseProvider": "SQLite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=skfabricator.db"
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "skfabricator-client",
    "Key": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS",
    "ExpireMinutes": 30,
    "RefreshTokenExpireDays": 7
  },
  "CloudinarySettings": {
    "CloudName": "REPLACE_WITH_CLOUD_NAME",
    "ApiKey": "REPLACE_WITH_API_KEY",
    "ApiSecret": "REPLACE_WITH_API_SECRET"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_EMAIL",
    "Password": "REPLACE_WITH_APP_PASSWORD",
    "FromName": "SK Fabricator & Erector",
    "ToEmail": "REPLACE_WITH_RECIPIENT_EMAIL"
  }
}

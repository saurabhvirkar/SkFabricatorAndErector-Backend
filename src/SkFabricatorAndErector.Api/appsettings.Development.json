{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200",
    "https://localhost:7001"
  ],
  "DatabaseProvider": "SQLite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=skfabricator_dev.db"
  },
  "Jwt": {
    "Issuer": "https://localhost:7001",
    "Audience": "skfabricator-client-dev",
    "Key": "DEV_ONLY_SECRET_KEY_NEVER_USE_IN_PRODUCTION_MIN_32_CHARS",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "CloudinarySettings": {
    "CloudName": "REPLACE_WITH_DEV_CLOUD_NAME",
    "ApiKey": "REPLACE_WITH_DEV_API_KEY",
    "ApiSecret": "REPLACE_WITH_DEV_API_SECRET",
    "Folder": "sk-fabricator/dev"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_EMAIL",
    "Password": "REPLACE_WITH_APP_PASSWORD",
    "FromName": "SK Fabricator & Erector",
    "ToEmail": "REPLACE_WITH_RECIPIENT_EMAIL"
  }
}

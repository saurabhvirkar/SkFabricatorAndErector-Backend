{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://qa.skfabricator.com",
    "https://sk-fabricator-qa.pages.dev"
  ],
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=ep-qa-pooler.neon.tech;Database=skfabricator_qa;Username=REPLACE_WITH_QA_DB_USER;Password=REPLACE_WITH_QA_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Issuer": "https://api-qa.skfabricator.com",
    "Audience": "skfabricator-qa-client",
    "Key": "REPLACE_WITH_QA_JWT_SECRET_KEY_MIN_32_CHARS",
    "ExpireMinutes": 30,
    "RefreshTokenExpireDays": 7
  },
  "CloudinarySettings": {
    "CloudName": "REPLACE_WITH_QA_CLOUD_NAME",
    "ApiKey": "REPLACE_WITH_QA_API_KEY",
    "ApiSecret": "REPLACE_WITH_QA_API_SECRET",
    "Folder": "sk-fabricator/qa"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_QA_EMAIL",
    "Password": "REPLACE_WITH_QA_APP_PASSWORD",
    "FromName": "SK Fabricator & Erector (QA)",
    "ToEmail": "REPLACE_WITH_QA_RECIPIENT_EMAIL"
  }
}
